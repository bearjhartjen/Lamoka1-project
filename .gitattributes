# GitHub Linguist has no single "KiCad" language, only two (verified against
# linguist lib/linguist/languages.yml; both are `type: data` and share the
# colour #2f4aab):
#   .kicad_pcb / .kicad_mod / .kicad_wks (+ fp-lib-table) -> "KiCad Layout"
#   .kicad_sch / .kicad_sym                            -> "KiCad Schematic"
#
# A previous revision of this file set `linguist-language=KiCad` to merge
# them into one bar entry. That name is not in languages.yml, and Linguist
# resolves an unknown override to NO language at all (see
# linguist/lib/linguist/lazy_blob.rb: `Language.find_by_alias` returns nil),
# so every design file fell out of the language stats. The only countable
# source left was the nine Arduino sketches then under
# SOFTWARE/Portal Interface Engine/ (*.ino -> C++, ~300 KB), hence the bar
# read 100% C++. PIE is now two heads totalling ~100 KB. `linguist-language` can only name an already-existing
# language, so a merged "KiCad" entry is impossible - and `linguist-color`
# is not a real attribute (ignored).
#
# Fix: mark the two real KiCad languages detectable instead. Data/prose
# languages are excluded from the bar by default; `linguist-detectable` opts
# them back in (linguist docs/overrides.md). Expected bar from tracked bytes
# (~3.9 MB Layout, ~1.3 MB Schematic, ~0.1 MB C++ after PIE was consolidated
# to the V1.8/V1.9 heads): ~73% KiCad Layout, ~25% KiCad Schematic, ~2% C++ -
# one same-coloured KiCad block plus the firmware slice. The Layout/Schematic
# split is byte-true: the finished 2.4 MB control-board .kicad_pcb dominates
# because KiCad inlines every track segment and filled-zone polygon.
#
# NOTE: GitHub only honours .gitattributes once it is committed and pushed;
# the language bar recomputes on push (can take a few minutes).

*.kicad_pcb linguist-detectable=true
*.kicad_sch linguist-detectable=true
*.kicad_sym linguist-detectable=true
*.kicad_mod linguist-detectable=true
*.kicad_wks linguist-detectable=true

# .kicad_pro (netclasses, DRC severities, ERC exclusions) and .kicad_dru
# (custom DRC rules) have no Linguist mapping at all, and sym-lib-table has
# none either (fp-lib-table IS listed under "KiCad Layout" filenames, so it
# counts as Layout). With no language attached these stay out of the bar
# (~20 KB total - immaterial); the detectable flag is kept so they count
# automatically if upstream ever maps them.
*.kicad_pro linguist-detectable=true
*.kicad_dru linguist-detectable=true

fp-lib-table linguist-detectable=true
sym-lib-table linguist-detectable=true

# Per-user editor state (visible layers, cursor position, zoom). Already
# gitignored under HARDWARE/ and Lamoka1-DEV-Brain/, excluded here as well so a
# stray tracked copy can never be counted as design source.
*.kicad_prl linguist-vendored
*.kicad_pro.bak linguist-vendored

# --- Generated output -------------------------------------------------------
# Everything below is written by a tool, not authored by hand. Excluded
# explicitly so the bar measures authored design work, and so a future Linguist
# release retyping an extension cannot silently add megabytes of artifacts.
# Most of these are already outside the bar by accident, which is fragile: JSON
# is `type: data` today, so a generated ERC report (Lamoka1-half-erc.json, kept
# out of the tree) was being excluded by luck rather than by decision.

# InteractiveHtmlBom plugin output
**/BOM/*.html linguist-generated=true
**/*interactive BOM.html linguist-generated=true

# kicad-cli sch erc / pcb drc output
Lamoka1-half-erc.json linguist-generated=true
*.rpt linguist-generated=true

# BOM and pick-and-place exports
*.csv linguist-generated=true

# Fabrication output. Deliberately committed for PCB reproducibility (see the
# "DO COMMIT THESE" note in HARDWARE/.gitignore), but plot/drill output is not
# design source.
*.gbr linguist-generated=true
*.gbrjob linguist-generated=true
*.drl linguist-generated=true

# --- License texts ----------------------------------------------------------
# REUSE-style copies of the root LICENSE-HARD / LICENSE-SOFT texts, kept under
# SPDX file names. Prose, not source; keep them out of the language bar.
LICENSES/** linguist-documentation

# --- Third-party artifacts --------------------------------------------------
*.xls linguist-vendored

# Round-tracks routing plug-in config
*.round-tracks-config linguist-vendored

# Mechanical exports (HARDWARE/Mechanical/): board STEP models generated by
# kicad-cli from the layouts, committed on purpose for enclosure/mechanical
# integration — not design source, so keep them out of the language bar.
*.step linguist-generated=true