# GitHub Linguist classifies KiCad files as `type: data`, which is excluded
# from the language statistics bar by default. Without these lines the repo
# appears to be "mostly HTML" even though the KiCad sources are the project.
# `linguist-detectable=true` forces them into the stats.

*.kicad_pcb linguist-detectable=true
*.kicad_sch linguist-detectable=true
*.kicad_sym linguist-detectable=true
*.kicad_mod linguist-detectable=true
*.kicad_wks linguist-detectable=true

# KiCad project/settings files have no Linguist extension mapping.
# .kicad_pro is JSON, .kicad_dru is plain text. JSON is also `type: data`,
# so it needs the detectable flag too.
*.kicad_pro linguist-language=JSON linguist-detectable=true
*.kicad_dru linguist-language=Text linguist-detectable=true

# Interactive BOM exports are generated by the InteractiveHtmlBom plugin,
# not hand-written. Excluding them stops a 690 KB tool artifact from
# dominating the language bar.
**/BOM/*.html linguist-generated=true
