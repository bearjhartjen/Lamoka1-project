# GitHub Linguist classifies every KiCad extension as `type: data`, which the
# language bar excludes by default, so none of the design source would be
# counted without these lines.
#
# Linguist has no single KiCad language. It splits the design across two names
# (verified against linguist lib/linguist/languages.yml):
#   .kicad_pcb / .kicad_mod / .kicad_wks -> "KiCad Layout"     (type: data)
#   .kicad_sch / .kicad_sym               -> "KiCad Schematic"  (type: data)
# That split is byte-weighted, and `.kicad_pcb` is pathologically large because
# KiCad stores every track segment, via and *filled zone polygon* in the file. So
# one finished 2.42 MB control board outweighed all 7 schematics 2.6:1 and the
# bar reported the repo as ~70% "Layout" - which is backwards here: the main
# inverter board is the *less* complete of the two, its power stage still
# unrouted. Forcing one language keeps the bar's only claim true, namely that
# this is a KiCad project. The real layout/schematic breakdown belongs in the
# README, not in a byte ratio that misstates it.
# `linguist-color` is Linguist's own colour for KiCad; a custom language name
# has no colour of its own.

*.kicad_pcb linguist-language=KiCad linguist-detectable=true linguist-color=#2f4aab
*.kicad_sch linguist-language=KiCad linguist-detectable=true linguist-color=#2f4aab
*.kicad_sym linguist-language=KiCad linguist-detectable=true linguist-color=#2f4aab
*.kicad_mod linguist-language=KiCad linguist-detectable=true linguist-color=#2f4aab
*.kicad_wks linguist-language=KiCad linguist-detectable=true linguist-color=#2f4aab

# KiCad project files with no Linguist extension mapping. These are hand-
# maintained design data, not JSON/Text source: .kicad_pro holds netclasses, DRC
# severities and ERC exclusions; .kicad_dru holds custom DRC rules. Labelling
# them "JSON" and "Text" put 37 KB of project config and one 370-byte rules file
# into the bar as two separate languages, so they count as KiCad instead.
*.kicad_pro linguist-language=KiCad linguist-detectable=true linguist-color=#2f4aab
*.kicad_dru linguist-language=KiCad linguist-detectable=true linguist-color=#2f4aab

# Library tables, matched by name rather than extension. Linguist does know
# fp-lib-table (it is listed under "KiCad Layout" filenames), but that language is
# `type: data`, so it was being dropped from the bar by accident rather than by
# decision; sym-lib-table has no mapping at all. Both are authored KiCad project
# configuration, same class as .kicad_pro, so both count as KiCad.
fp-lib-table linguist-language=KiCad linguist-detectable=true linguist-color=#2f4aab
sym-lib-table linguist-language=KiCad linguist-detectable=true linguist-color=#2f4aab

# Per-user editor state (visible layers, cursor position, zoom). Already
# gitignored under HARDWARE/ and Lamoka1-DEV-Brain/, excluded here as well so a
# stray tracked copy can never be counted as design source.
*.kicad_prl linguist-vendored
*.kicad_pro.bak linguist-vendored

# --- Generated output -------------------------------------------------------
# Everything below is written by a tool, not authored by hand. Excluded
# explicitly so the bar measures authored design work, and so a future Linguist
# release retyping an extension cannot silently add megabytes of artifacts.
# Most of these are already outside the bar by accident, which is fragile: JSON
# is `type: data` today, so Lamoka1-erc.json (66 KB, the largest JSON here) was
# being excluded by luck rather than by decision.

# InteractiveHtmlBom plugin output
**/BOM/*.html linguist-generated=true

# kicad-cli sch erc / pcb drc output
Lamoka1-erc.json linguist-generated=true
*.rpt linguist-generated=true

# BOM and pick-and-place exports
*.csv linguist-generated=true

# Fabrication output. Deliberately committed for PCB reproducibility (see the
# "DO COMMIT THESE" note in HARDWARE/.gitignore), but plot/drill output is not
# design source.
*.gbr linguist-generated=true
*.gbrjob linguist-generated=true
*.drl linguist-generated=true

# --- Third-party artifacts --------------------------------------------------
*.xls linguist-vendored

# Round-tracks routing plug-in config
*.round-tracks-config linguist-vendored