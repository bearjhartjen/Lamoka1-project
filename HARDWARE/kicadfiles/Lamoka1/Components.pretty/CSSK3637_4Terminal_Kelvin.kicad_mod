(footprint "CSSK3637_4Terminal_Kelvin"
  (version 20221018)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "Stackpole CSSK3637 3 W four-terminal Kelvin current-sense resistor; manufacturer recommended solder land pattern")
  (tags "CSSK3637 current sense shunt Kelvin 4-terminal 3637")
  (attr smd)

  (fp_text reference "REF**"
    (at 0 -6.4)
    (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (fp_text value "CSSK3637_4Terminal_Kelvin"
    (at 0 6.4)
    (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )

  (fp_line
    (start -1.65 -4.95)
    (end 1.65 -4.95)
    (stroke (width 0.15) (type solid))
    (layer "F.SilkS")
  )
  (fp_line
    (start -1.65 4.95)
    (end 1.65 4.95)
    (stroke (width 0.15) (type solid))
    (layer "F.SilkS")
  )
  (fp_line
    (start -1.65 -4.95)
    (end -1.25 -5.35)
    (stroke (width 0.15) (type solid))
    (layer "F.SilkS")
  )

  (fp_rect
    (start -4.57 -4.80)
    (end 4.57 4.80)
    (stroke (width 0.10) (type solid))
    (fill none)
    (layer "F.Fab")
  )
  (fp_text user "${REFERENCE}"
    (at 0 0)
    (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )

  (fp_rect
    (start -5.55 -5.40)
    (end 5.55 5.65)
    (stroke (width 0.05) (type solid))
    (fill none)
    (layer "F.CrtYd")
  )

  (pad "1" smd rect
    (at -3.65 -1.16)
    (size 3.30 7.92)
    (layers "F.Cu" "F.Paste" "F.Mask")
  )
  (pad "2" smd rect
    (at -3.65 4.39)
    (size 3.30 1.98)
    (layers "F.Cu" "F.Paste" "F.Mask")
  )
  (pad "3" smd rect
    (at 3.65 4.39)
    (size 3.30 1.98)
    (layers "F.Cu" "F.Paste" "F.Mask")
  )
  (pad "4" smd rect
    (at 3.65 -1.16)
    (size 3.30 7.92)
    (layers "F.Cu" "F.Paste" "F.Mask")
  )
)
