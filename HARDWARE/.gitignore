################################
# KiCad Project-Local State
################################

# Project-specific editor state (zoom, visible layers, window position)
# These change every time anyone opens the file → merge conflicts if tracked
*.kicad_prl

# Auto-recovery and swap files
*.kicad_sch-bak
*.kicad_pcb-bak
*.kicad_sch~
*.kicad_pcb~
_autosave-*

# Cache and lock files
fp-info-cache
sym-lib-cache
# KiCad 10 names its GUI lock files "~<project>.lck"; older versions used
# ".lock". Both are per-session state, never design source.
*.lck
*.kicad_sch.lock
*.kicad_pcb.lock
*.Kicad_pro.Ick

# KiCad plug-in session artifacts (regenerated locally, not design sources)
*.round-tracks-config
report.txt

################################
# KiCad Backups
################################

# KiCad auto-backup zips (git already versions the source)
*-backups/
*.bak
*~

################################
# Simulation & Analysis Output
# (Regenerable from schematic & netlists)
################################

*.cir
*.out
*.log
*.raw
*.meas
*.ac
*.transient
# This is ngspice `.step` sweep output. STEP 3D exports are re-included below:
# HARDWARE/Mechanical/ carries the assembly model for mechanical integration.
*.step
!Mechanical/*.step
*.sweep

################################
# RESTRICTED/VENDOR FILES
# These have license restrictions that forbid redistribution
# Link to datasheets instead; users can download from vendors
################################

# Texas Instruments restricted files
# → Users should download directly from ti.com under their terms
*.pdf
*.xlsx
*.xlsm
*.docx
ImportGuide*.html
ImportGuide*.htm

# Our own procurement records are not vendor docs: the DigiKey order
# acknowledgements and the customs spreadsheet we sent PCBWay are authored
# by us for this build, so they stay tracked despite the rules above.
!Lamoka1-half fab files/DigiKey orders/*.pdf
!Lamoka1-half fab files/DigiKey orders/*.xlsx

# Other vendor documentation
# → Assume any PDFs/Office docs in hardware dirs are vendor-supplied
**/vendor/**
**/3rdparty/**

################################
# PRIVATE KICAD LIBRARY SOURCES
# Symbols, footprints, and 3D models are kept local, not committed or
# redistributed: the .kicad_sch and .kicad_pcb files carry embedded copies of
# everything the design needs (see AGENTS.md, "Repository practice").
################################

*.kicad_sym
*.kicad_mod
*.pretty
components

################################
# Manufacturing Output
# DO COMMIT THESE—they enable full PCB reproducibility
# Users can order directly from a fab using Gerber/drill files
################################

# (Gerber, drill, and other manufacturing files are TRACKED)
# No exclusions here—everything in /manufacturing/ folders stays

################################
# IDE/Editor/Machine-Specific
################################

# VS Code
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
.project
.classpath
*.iml
*.iws
*.ipr

# Sublime Text
.sublime-project
.sublime-workspace
*.sublime-session

# vim/neovim
.vim/
.netrwhist
[._]*.s[a-v][a-z]
[._]*.sw[a-p]

################################
# OS Files
################################

# macOS
.DS_Store
.AppleDouble
.LSOverride
.AppleDB
.AppleDesktop
.CFUserTextEncoding
.Spotlight-V100
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent
Network Trash Folder
Temporary Items

# Windows
Thumbs.db
.Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.nfs*
.fuse_*

################################
# Temporary/Build Files
################################

*.tmp
*.temp
*.log
*.swp
*.swo
*~

################################
# Python (if using KiCad scripting plugins)
################################

__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

################################
# Node/npm (if using Node-based tools)
################################

node_modules/
npm-debug.log
yarn-error.log

################################
# Build/Output Directories
################################

/build/
/dist/
/out/
*.o
*.so
*.a

 ################################
# Backup folder
################################

Lamoka1-half-backups/