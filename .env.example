# Optional local overrides for the Makefile. Copy this file to `.env`
# (gitignored) and edit; make picks the values up automatically:
#
#     cp .env.example .env
#
# Every setting is optional — the targets have working defaults. `make help`
# lists the targets.

# Serial port used by `make upload` (default: /dev/ttyACM0).
PORT=/dev/ttyACM0

# Sketch compiled and flashed (default: the DEV-Brain PIE head, V1.8).
#SKETCH=SOFTWARE/Portal Interface Engine/V1.8.ino
# The main board uses its own head instead:
#SKETCH=SOFTWARE/Portal Interface Engine/V1.9.ino

# Board FQBN (default: the DEV-Brain's RP2354A as a Generic RP2350).
#FQBN=rp2040:rp2040:generic_rp2350

# Scratch directory for staged sketches and exported binaries (default: build).
#BUILD_DIR=build
